{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Looji",
  "version": "0.2.0",
  "identifier": "com.loojihq.looji",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwREIzRDQzMzQ3QTdFMjMKUldRamZubzBRejNiRVBnUHRBMUd3K3kxQW5INmpkbzd1U1Fyc1hzMkJ2M2M1WTFwazJES1FWY0kK",
      "endpoints": [
        "https://github.com/loojihq/looji-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
